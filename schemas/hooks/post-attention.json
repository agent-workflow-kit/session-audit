{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/hooks/post-attention.json",
  "title": "post-attention hook payload",
  "description": "Stdin JSON of the post-attention hook: a closed reason and a closed details set. Cannot undo.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "session-audit"
    },
    "hook": {
      "const": "post-attention"
    },
    "object_type": {
      "enum": [
        "retro",
        "ingest"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "event_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^ev-[a-z2-7]{26}(?![\\s\\S])"
    },
    "labels": {
      "type": "object",
      "propertyNames": {
        "$ref": "../defs.json#/$defs/label_key"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9._:/#@+=,-]{0,256}(?![\\s\\S])"
      },
      "maxProperties": 0,
      "description": "Always {}: retros have no labels."
    },
    "reason": {
      "enum": [
        "retro_failed",
        "ingest_failing"
      ]
    },
    "details": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "retro_id": {
              "$ref": "../defs.json#/$defs/retro_id"
            },
            "failure_reason": {
              "enum": [
                "runner_lost",
                "session_not_started",
                "claude_session_error",
                "session_failed",
                "no_artifact",
                "artifact_invalid",
                "identity_mismatch",
                "marker_mismatch",
                "no_valid_findings"
              ]
            },
            "csession_id": {
              "anyOf": [
                {
                  "$ref": "../defs.json#/$defs/csession_id"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "retro_id",
            "failure_reason",
            "csession_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "consecutive_failures": {
              "type": "integer",
              "minimum": 1
            },
            "first_failed_at": {
              "$ref": "../defs.json#/$defs/timestamp"
            },
            "last_failed_at": {
              "$ref": "../defs.json#/$defs/timestamp"
            }
          },
          "required": [
            "consecutive_failures",
            "first_failed_at",
            "last_failed_at"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "event_id",
    "labels",
    "reason",
    "details"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "retro_failed"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "object_type": {
            "const": "retro"
          },
          "details": {
            "required": [
              "retro_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reason": {
            "const": "ingest_failing"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "properties": {
          "object_type": {
            "const": "ingest"
          },
          "object_id": {
            "const": "ingest"
          },
          "details": {
            "required": [
              "consecutive_failures"
            ]
          }
        }
      }
    }
  ]
}
