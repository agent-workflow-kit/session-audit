{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/config.json",
  "title": "session-audit config",
  "description": "Merged config after config.yaml and config.d/*.yaml. Self-contained (no external $ref). Every key is optional and takes its default. Unknown keys are refused. Range checks of string durations (the stated maxima) and cross-key checks are made by the tool. Only retro.timeout and retro.model have environment variables.",
  "type": "object",
  "properties": {
    "transcript_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "Replaces both default roots (~/.claude/projects and $CLAUDE_CONFIG_DIR/projects)."
    },
    "time_zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+/-]{1,64}(?![\\s\\S])",
      "description": "IANA zone for day, week and month bucketing. Default: the machine's zone."
    },
    "ingest": {
      "type": "object",
      "properties": {
        "budget": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
            }
          ],
          "description": "Time budget per ingest run, at most 3600 s.",
          "default": "300s"
        },
        "file_budget": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 600
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
            }
          ],
          "description": "Time budget per file, at most 600 s.",
          "default": "60s"
        },
        "fail_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 3,
          "description": "Consecutive failed full ingests before ingest_failing."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "enabled": {
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "auto uses claude-session when installed; on makes a missing one a failed check; off skips it."
        },
        "claude_session_cmd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._/+-]{1,256}(?![\\s\\S])",
          "description": "Binding A command name.",
          "default": "claude-session"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "prices": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
          "description": "Date of the table (YYYY-MM-DD); validate warns when older than 180 days."
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "output": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "cache_read": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "cache_write": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              },
              "cache_write_1h": {
                "type": "number",
                "minimum": 0,
                "maximum": 1000000
              }
            },
            "required": [
              "input",
              "output",
              "cache_read",
              "cache_write"
            ],
            "additionalProperties": false,
            "description": "USD per million tokens. cache_write_1h defaults to cache_write."
          },
          "maxProperties": 256,
          "description": "Model name (exact or prefix; longest prefix wins) to prices. Extends the bundled table."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "mismatch_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Fraction for the cost_mismatch flag (set only when the session's reported cost is not null)."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "sessions": {
          "$ref": "#/$defs/duration_d",
          "default": "400d",
          "description": "Sessions, agents, events (by the end of the counted events, else the files, else the last ingest) and harness runs (by their own updated_at); at most 3650 d."
        },
        "retros": {
          "$ref": "#/$defs/duration_d",
          "default": "180d",
          "description": "Stored retros."
        },
        "digests": {
          "$ref": "#/$defs/duration_d",
          "default": "7d",
          "description": "Stored digests."
        },
        "log": {
          "$ref": "#/$defs/duration_d",
          "default": "90d",
          "description": "log.jsonl entries."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "retros_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 5,
          "description": "Daily retro limit."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retro": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
          "default": "session-audit:audit",
          "description": "The slot's skill."
        },
        "skill_marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Marker a custom skill must write. Default: none."
        },
        "plugin_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\x00]{0,4095}(?![\\s\\S])"
          },
          "maxItems": 8,
          "uniqueItems": true,
          "default": [],
          "description": "Extra plugin directories (absolute paths) for a custom skill; each passed with --plugin-dir. claude-session refuses credential locations (a plugin under ~/.claude/plugins cannot be used). The preflight also requires every file and directory of each entry to be owned by the user and not group or other writable (exit 12 unsafe_plugin_dir)."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Default: Claude Code's default."
        },
        "timeout": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 7200
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))(?:[0-9]{1,9}(\\.[0-9]+)?(s|m)?|[1-9][0-9]{3,8}ms)(?![\\s\\S])"
            }
          ],
          "description": "Session timeout, 1 s to 2 h.",
          "default": "20m"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 12,
          "description": "Session turn bound."
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Sessions per retro."
        },
        "quiet_after": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 604800
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
            }
          ],
          "description": "Minimum age since a transcript last changed, at most 7 d.",
          "default": "30m"
        },
        "permission_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Replaces the bundled profile file. Default: the bundled file."
        },
        "sandbox": {
          "enum": [
            "required",
            "preferred",
            "off"
          ],
          "default": "required",
          "description": "Sandbox level passed per call. A lower value is passed only when stdin is a terminal; without one retro run refuses (config_unsafe). validate warns sandbox_lowered."
        },
        "setting_sources": {
          "type": "array",
          "items": {
            "enum": [
              "user",
              "project",
              "local"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "default": [],
          "description": "Must stay [] for a third-party-reading run; kept because the design guide requires the key."
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": [
            "PATH",
            "HOME",
            "USER",
            "LANG",
            "TERM"
          ],
          "description": "Names passed with --env-allowlist-only."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Z][A-Za-z]{1,31}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "default": [
            "Read",
            "Write",
            "Bash",
            "Skill"
          ],
          "description": "The --tools list: names from claude-session's --tools list (the launch plan check catches the rest)."
        },
        "remove_run_transcripts": {
          "type": "boolean",
          "default": true,
          "description": "Remove the retro session's own transcript files after collecting."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "$ref": "#/$defs/size",
          "default": "200KB",
          "description": "Total digest cap."
        },
        "session_max_bytes": {
          "$ref": "#/$defs/size",
          "default": "20KB",
          "description": "Per-session cap."
        },
        "prompt_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 65536,
          "default": 500,
          "description": "Cut of a prompt item."
        },
        "assistant_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 65536,
          "default": 300,
          "description": "Cut of an assistant item."
        },
        "arg_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 65536,
          "default": 200,
          "description": "Cut of a tool argument summary."
        },
        "error_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 65536,
          "default": 300,
          "description": "Cut of an error, denial, interruption or rejection item."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "mask_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": [],
          "description": "Variable names whose set values are masked."
        },
        "extra_token_prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
          },
          "maxItems": 64,
          "default": [],
          "description": "Token prefixes; <prefix>[A-Za-z0-9_-]{8,256} is redacted."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "retro": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "weekday": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "default": 1,
                  "description": "Cron weekday, 0 Sunday."
                },
                "hour": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 23,
                  "default": 9,
                  "description": "Cron hour; the minute is 23."
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 400,
                        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}=[A-Za-z0-9._:/#@+=,-]{0,256}(?![\\s\\S])"
                      },
                      "maxItems": 64,
                      "uniqueItems": true
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "since": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 10,
                      "pattern": "^[1-9][0-9]{0,8}[smhd](?![\\s\\S])",
                      "description": "A duration ago, the WHEN grammar: <n>(s|m|h|d)."
                    },
                    "until": {
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 10,
                      "pattern": "^[1-9][0-9]{0,8}[smhd](?![\\s\\S])",
                      "description": "A duration ago, the WHEN grammar: <n>(s|m|h|d)."
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
                    },
                    "outcome": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "since"
                  ],
                  "additionalProperties": false,
                  "description": "Scope flags of retro run; since (required) and until are durations ago."
                }
              },
              "required": [
                "scope"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional weekly retro from cron. Off when null or absent."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-retro": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 600
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
                  }
                ],
                "description": "Default 30 seconds, at most 600 s."
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-retro": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 600
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
                  }
                ],
                "description": "Default 30 seconds, at most 600 s."
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-attention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "anyOf": [
                  {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 600
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
                  }
                ],
                "description": "Default 30 seconds, at most 600 s."
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Hook lists; drop-ins append."
    },
    "me": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?!.*\\.\\.)[A-Za-z0-9][A-Za-z0-9._@/-]{0,63}(?![\\s\\S])",
          "description": "Actor name: starts with a letter or digit, no \"..\". Default: the OS user name with every character outside [A-Za-z0-9._@/-] replaced by _, every run of dots by one _, leading characters that are not a letter or digit dropped, cut to 64."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 7200
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
        }
      ],
      "description": "Seconds, or a string [0-9]+(.[0-9]+)?(ms|s|m)? (no unit means seconds; zero is refused). Maximum 7200 s."
    },
    "duration_d": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 315360000
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?!0+(\\.0+)?(ms|s|m|d)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m|d)?(?![\\s\\S])"
        }
      ],
      "description": "Seconds, or a string [0-9]+(.[0-9]+)?(ms|s|m|d)? (no unit means seconds; zero is refused). Maximum 315360000 s."
    },
    "size": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "pattern": "^[1-9][0-9]{0,9}(B|KB|MB)?(?![\\s\\S])"
        }
      ],
      "description": "Bytes, or a whole number followed by B, KB or MB (1 KB = 1024 bytes); no fraction, no zero."
    }
  }
}
