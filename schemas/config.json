{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/config.json",
  "title": "session-audit config",
  "description": "Merged config after config.yaml and config.d/*.yaml. Self-contained (no external $ref). Every key is optional and takes its default. Unknown keys are refused. Range checks of durations and cross-key checks are made by the tool. Only retro.timeout and retro.model have environment variables.",
  "type": "object",
  "properties": {
    "transcript_roots": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 16,
      "description": "Replaces both default roots (~/.claude/projects and $CLAUDE_CONFIG_DIR/projects)."
    },
    "time_zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+/-]{1,64}(?![\\s\\S])",
      "description": "IANA zone for day, week and month bucketing. Default: the machine's zone."
    },
    "ingest": {
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/duration",
          "default": "300s",
          "description": "Time budget per ingest run."
        },
        "fail_threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 3,
          "description": "Consecutive failed cron ingests before ingest_failing."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "enabled": {
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "default": "auto",
          "description": "auto uses claude-session when installed; on makes a missing one a failed check; off skips it."
        },
        "claude_session_cmd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9._/+-]{1,256}(?![\\s\\S])",
          "description": "Binding B command name.",
          "default": "claude-session"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "prices": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
          "description": "Date of the table (YYYY-MM-DD); validate warns when older than 180 days."
        },
        "models": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]{0,127}(?![\\s\\S])"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "input": {
                "type": "number",
                "minimum": 0
              },
              "output": {
                "type": "number",
                "minimum": 0
              },
              "cache_read": {
                "type": "number",
                "minimum": 0
              },
              "cache_write": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "input",
              "output",
              "cache_read",
              "cache_write"
            ],
            "additionalProperties": false,
            "description": "USD per million tokens."
          },
          "maxProperties": 256,
          "description": "Model name (exact or prefix; longest prefix wins) to prices. Extends the bundled table."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "mismatch_margin": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "Fraction for the cost_mismatch flag."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "sessions": {
          "$ref": "#/$defs/duration_d",
          "default": "400d",
          "description": "Sessions, agents, usage rows, harness snapshots."
        },
        "retros": {
          "$ref": "#/$defs/duration_d",
          "default": "180d",
          "description": "Stored retros."
        },
        "digests": {
          "$ref": "#/$defs/duration_d",
          "default": "7d",
          "description": "Stored digests."
        },
        "log": {
          "$ref": "#/$defs/duration_d",
          "default": "90d",
          "description": "log.jsonl entries."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "retros_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 5,
          "description": "Daily retro limit."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retro": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{0,127}(?![\\s\\S])",
          "default": "session-audit:audit",
          "description": "The slot's skill."
        },
        "skill_marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Marker a custom skill must write. Default: none."
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Default: Claude Code's default."
        },
        "timeout": {
          "$ref": "#/$defs/duration",
          "default": "20m",
          "description": "Session timeout."
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 12,
          "description": "Session turn bound."
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "default": 20,
          "description": "Sessions per retro."
        },
        "quiet_after": {
          "$ref": "#/$defs/duration",
          "default": "30m",
          "description": "Minimum age since a transcript last changed."
        },
        "permission_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "Replaces the bundled profile file. Default: the bundled file."
        },
        "sandbox": {
          "enum": [
            "required",
            "preferred",
            "off"
          ],
          "default": "required",
          "description": "Sandbox level passed per call."
        },
        "setting_sources": {
          "type": "array",
          "items": {
            "enum": [
              "user",
              "project",
              "local"
            ]
          },
          "maxItems": 3,
          "uniqueItems": true,
          "default": [],
          "description": "Setting sources passed per call."
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": [
            "PATH",
            "HOME",
            "USER",
            "LANG",
            "TERM"
          ],
          "description": "Names passed with --env-allowlist-only."
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_*:.-]{0,63}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "default": [
            "Read",
            "Write",
            "Bash",
            "Skill"
          ],
          "description": "The --tools list."
        },
        "remove_run_transcripts": {
          "type": "boolean",
          "default": true,
          "description": "Remove the retro session's own transcript files after collecting."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "digest": {
      "type": "object",
      "properties": {
        "max_bytes": {
          "$ref": "#/$defs/size",
          "default": "200KB",
          "description": "Total digest cap."
        },
        "session_max_bytes": {
          "$ref": "#/$defs/size",
          "default": "20KB",
          "description": "Per-session cap."
        },
        "prompt_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100000,
          "default": 500,
          "description": "Cut of a prompt item."
        },
        "assistant_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100000,
          "default": 300,
          "description": "Cut of an assistant item."
        },
        "arg_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100000,
          "default": 200,
          "description": "Cut of a tool argument summary."
        },
        "error_chars": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100000,
          "default": 300,
          "description": "Cut of an error, denial, interruption or rejection item."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "mask_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": [],
          "description": "Variable names whose set values are masked."
        },
        "extra_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 64,
          "default": [],
          "description": "Extra regular expressions (compiled by the tool with a length and time guard)."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "properties": {
        "retro": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "every": {
                  "$ref": "#/$defs/duration_d",
                  "default": "7d",
                  "description": "Interval of the cron retro run."
                },
                "scope": {
                  "type": "object",
                  "properties": {
                    "labels": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 400,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}=[^\\n\\r]{0,256}(?![\\s\\S])"
                      },
                      "maxItems": 64,
                      "uniqueItems": true
                    },
                    "project": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4096
                    },
                    "since": {
                      "$ref": "#/$defs/duration_d"
                    },
                    "until": {
                      "$ref": "#/$defs/duration_d"
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "outcome": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])"
                    }
                  },
                  "required": [],
                  "additionalProperties": false,
                  "description": "Scope flags of retro run; since and until are durations ago.",
                  "minProperties": 1
                }
              },
              "required": [
                "scope"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional weekly window retro run from cron. Off when null or absent."
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-retro": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/duration",
                "description": "Default 30 seconds."
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-retro": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/duration",
                "description": "Default 30 seconds."
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-attention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/duration",
                "description": "Default 30 seconds."
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Hook lists; drop-ins append."
    },
    "me": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._@/-]{1,64}(?![\\s\\S])",
          "description": "Actor name. Default: the OS user name."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3153600000
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]{1,10}(\\.[0-9]{1,9})?(ms|s|m)?(?![\\s\\S])"
        }
      ],
      "description": "Seconds, or a string [0-9]+(.[0-9]+)?(ms|s|m)? (no unit means seconds)."
    },
    "duration_d": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3153600000
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9]{1,10}(\\.[0-9]{1,9})?(ms|s|m|d)?(?![\\s\\S])"
        }
      ],
      "description": "As duration, and a d suffix (days) is also accepted."
    },
    "size": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16,
      "pattern": "^[0-9]{1,12}(B|KB|MB)?(?![\\s\\S])",
      "description": "Bytes, or a number followed by B, KB or MB (1 KB = 1024 bytes)."
    }
  }
}
