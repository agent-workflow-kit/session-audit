{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/slot/manifest.json",
  "title": "retro input manifest",
  "description": "manifest.json under inputs/<run>/. Written by the tool. Ids, counts and enums only: no untrusted string. items lists only kept items. Every metric name is valid for every s<N> and for total; a ref whose value is null is still valid.",
  "type": "object",
  "properties": {
    "retro_id": {
      "$ref": "../defs.json#/$defs/retro_id"
    },
    "run_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
    },
    "digest_sha256": {
      "$ref": "../defs.json#/$defs/sha256"
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "$ref": "../defs.json#/$defs/ref"
          },
          "csession_id": {
            "anyOf": [
              {
                "$ref": "../defs.json#/$defs/csession_id"
              },
              {
                "type": "null"
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 11,
              "pattern": "^s([1-9][0-9]{0,1}|[1-4][0-9]{2}|500)\\.i[0-9]{3,6}(?![\\s\\S])"
            },
            "maxItems": 20000,
            "uniqueItems": true
          }
        },
        "required": [
          "ref",
          "csession_id",
          "items"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 500
    },
    "coverage": {
      "$ref": "../defs.json#/$defs/coverage"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_findings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "text_limits": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "title": {
              "type": "integer",
              "minimum": 1,
              "maximum": 120
            },
            "detail": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1500
            },
            "target_hint": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "proposal": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1500
            }
          },
          "required": [
            "summary",
            "title",
            "detail",
            "target_hint",
            "proposal"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "max_findings",
        "max_candidates",
        "text_limits"
      ],
      "additionalProperties": false
    },
    "finding_categories": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/category"
      },
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true
    },
    "target_classes": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/target_class"
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "required": [
    "retro_id",
    "run_token",
    "digest_sha256",
    "sessions",
    "coverage",
    "limits",
    "finding_categories",
    "target_classes"
  ],
  "additionalProperties": false
}
