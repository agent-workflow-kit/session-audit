{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json on success and failure. Exit 0 ok (warnings allowed), 2 invalid config, 12 a failed check. probe_* checks appear only with --probe.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "enum": [
              "config",
              "config_ownership",
              "transcript_roots",
              "store",
              "price_table",
              "permission_profile",
              "plugin",
              "claude_session",
              "probe_kinds",
              "probe_sandbox"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "enum": [
                  "config_invalid",
                  "config_unsafe",
                  "no_readable_roots",
                  "store_unreadable",
                  "store_newer",
                  "permission_profile_missing",
                  "plugin_missing",
                  "claude_session_missing",
                  "claude_session_too_old",
                  "probe_failed",
                  "sandbox_unavailable"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "ok",
          "reason"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "ok": {
                  "const": true
                }
              },
              "required": [
                "ok"
              ]
            },
            "then": {
              "properties": {
                "reason": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ]
      },
      "maxItems": 16
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "price_table_old",
          "migration_pending",
          "root_unusable",
          "claude_session_missing"
        ]
      },
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "ok",
    "checks",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
