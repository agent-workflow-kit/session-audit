{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/retro-list.json",
  "title": "retro list output",
  "description": "Newest first. Reads the store only.",
  "type": "object",
  "properties": {
    "retros": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/retro_row"
      },
      "maxItems": 1000
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "retros",
    "truncated"
  ],
  "additionalProperties": false
}
