{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/retro-show.json",
  "title": "retro show output",
  "description": "The Retro object, including the artifact fields; digest is present only with --digest (null when pruned) and is untrusted fenced text.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "../defs.json#/$defs/retro_id"
    },
    "state": {
      "$ref": "../defs.json#/$defs/retro_state"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/retro_reason"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "$ref": "../defs.json#/$defs/scope"
    },
    "coverage": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/coverage"
        },
        {
          "type": "null"
        }
      ]
    },
    "skipped": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/skipped"
      },
      "maxItems": 1000
    },
    "skill": {
      "$ref": "../defs.json#/$defs/skill"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "../defs.json#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "../defs.json#/$defs/timestamp"
    },
    "finished_at": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "csession_id": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/csession_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "cost_usd": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "num_turns": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/token"
        },
        {
          "type": "null"
        }
      ]
    },
    "again_of": {
      "anyOf": [
        {
          "$ref": "../defs.json#/$defs/retro_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "$ref": "../defs.json#/$defs/retro_counts"
    },
    "metrics": {
      "$ref": "../defs.json#/$defs/retro_metrics"
    },
    "dropped": {
      "type": "object",
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "candidates": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "findings",
        "candidates"
      ],
      "additionalProperties": false
    },
    "summary": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/finding"
      },
      "maxItems": 50
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/candidate"
      },
      "maxItems": 20
    },
    "digest": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 1048576,
          "x-untrusted": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "state",
    "reason",
    "key",
    "scope",
    "coverage",
    "skipped",
    "skill",
    "model",
    "created_at",
    "updated_at",
    "finished_at",
    "csession_id",
    "cost_usd",
    "num_turns",
    "outcome",
    "again_of",
    "counts",
    "metrics",
    "dropped",
    "summary",
    "findings",
    "candidates"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "done"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "enum": [
              "runner_lost",
              "no_artifact",
              "skill_not_found",
              "artifact_invalid",
              "identity_mismatch",
              "marker_mismatch",
              "no_valid_findings",
              "session_failed"
            ]
          }
        }
      }
    }
  ]
}
