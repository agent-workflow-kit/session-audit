{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/prune.json",
  "title": "prune output",
  "description": "Counts per table and per retention key. With dry_run true, what would be deleted.",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "tables": {
      "$ref": "../defs.json#/$defs/prune_tables"
    },
    "retention": {
      "$ref": "../defs.json#/$defs/prune_retention"
    }
  },
  "required": [
    "dry_run",
    "tables",
    "retention"
  ],
  "additionalProperties": false
}
