{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/show.json",
  "title": "show output",
  "description": "One stored session. The harness snapshot is inside session.",
  "type": "object",
  "properties": {
    "session": {
      "$ref": "../defs.json#/$defs/session"
    },
    "agents": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/agent"
      },
      "maxItems": 10000
    },
    "usage": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/usage_row"
      },
      "maxItems": 100000
    },
    "store": {
      "$ref": "../defs.json#/$defs/store_fresh"
    }
  },
  "required": [
    "session",
    "agents",
    "usage",
    "store"
  ],
  "additionalProperties": false
}
