{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/retro-run.json",
  "title": "retro run output",
  "description": "Printed with --json on exit 0 (a stored retro reused, a finished retro or the dry-run plan). Any non-zero exit prints the error envelope (details.retro_id names a retro that exists).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "../defs.json#/$defs/retro_id"
        },
        "state": {
          "$ref": "../defs.json#/$defs/retro_state"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/retro_reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "$ref": "../defs.json#/$defs/sha256"
        },
        "scope": {
          "$ref": "../defs.json#/$defs/scope"
        },
        "scope_resolved": {
          "type": "object",
          "properties": {
            "since": {
              "anyOf": [
                {
                  "$ref": "../defs.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "until": {
              "anyOf": [
                {
                  "$ref": "../defs.json#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "since",
            "until"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "$ref": "../defs.json#/$defs/coverage"
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/skipped"
          },
          "maxItems": 1000
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "../defs.json#/$defs/ref"
              },
              "session_id": {
                "$ref": "../defs.json#/$defs/session_id"
              },
              "csession_id": {
                "anyOf": [
                  {
                    "$ref": "../defs.json#/$defs/csession_id"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ref",
              "session_id",
              "csession_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 500,
          "description": "The kept sessions, for mapping evidence refs to sessions."
        },
        "skill": {
          "$ref": "../defs.json#/$defs/skill"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "../defs.json#/$defs/timestamp"
        },
        "updated_at": {
          "$ref": "../defs.json#/$defs/timestamp"
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "csession_id": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/csession_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "num_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "sandbox_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "cleanup": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "done",
                "incomplete",
                "skipped"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "transcripts_kept",
              "recovery_skipped",
              "ingest_busy"
            ]
          },
          "maxItems": 8,
          "uniqueItems": true
        },
        "redacted": {
          "type": "integer",
          "minimum": 0
        },
        "again_of": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/retro_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "$ref": "../defs.json#/$defs/retro_counts"
        },
        "metrics": {
          "$ref": "../defs.json#/$defs/retro_metrics"
        },
        "dropped": {
          "type": "object",
          "properties": {
            "findings": {
              "type": "integer",
              "minimum": 0
            },
            "candidates": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "findings",
            "candidates"
          ],
          "additionalProperties": false
        },
        "summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/finding"
          },
          "maxItems": 50
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/stored_candidate"
          },
          "maxItems": 20
        },
        "reused": {
          "type": "boolean"
        },
        "superseded": {
          "type": "boolean",
          "description": "Optional, as in the Retro object."
        }
      },
      "required": [
        "id",
        "state",
        "reason",
        "key",
        "scope",
        "scope_resolved",
        "coverage",
        "skipped",
        "sessions",
        "skill",
        "model",
        "created_at",
        "updated_at",
        "finished_at",
        "csession_id",
        "cost_usd",
        "num_turns",
        "outcome",
        "sandbox_active",
        "cleanup",
        "warnings",
        "redacted",
        "again_of",
        "counts",
        "metrics",
        "dropped",
        "summary",
        "findings",
        "candidates",
        "reused"
      ],
      "additionalProperties": false,
      "description": "The Retro object plus reused.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "digesting",
                  "running",
                  "validating"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "done"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "summary": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "runner_lost",
                  "session_not_started",
                  "claude_session_error",
                  "session_failed",
                  "no_artifact",
                  "artifact_invalid",
                  "identity_mismatch",
                  "marker_mismatch",
                  "no_valid_findings"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "escalated"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "hook_escalated",
                  "session_blocked",
                  "session_needs_input"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "canceled"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "interrupted",
                  "hook_vetoed"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "dry_run": {
          "const": true
        },
        "scope": {
          "$ref": "../defs.json#/$defs/scope"
        },
        "matched": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/session_id"
          },
          "maxItems": 1000,
          "description": "At most 1000 ids; matched_total counts them all."
        },
        "matched_total": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "array",
          "items": {
            "$ref": "../defs.json#/$defs/skipped"
          },
          "maxItems": 1000
        },
        "over_cap": {
          "type": "integer",
          "minimum": 0,
          "description": "Candidates never reached because retro.max_sessions was filled."
        },
        "items": {
          "type": "integer",
          "minimum": 0
        },
        "items_by_kind": {
          "type": "object",
          "properties": {
            "prompt": {
              "type": "integer",
              "minimum": 0
            },
            "assistant": {
              "type": "integer",
              "minimum": 0
            },
            "tool_call": {
              "type": "integer",
              "minimum": 0
            },
            "tool_error": {
              "type": "integer",
              "minimum": 0
            },
            "denial": {
              "type": "integer",
              "minimum": 0
            },
            "interruption": {
              "type": "integer",
              "minimum": 0
            },
            "rejection": {
              "type": "integer",
              "minimum": 0
            },
            "compaction": {
              "type": "integer",
              "minimum": 0
            },
            "subagent": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "digest_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "key": {
          "$ref": "../defs.json#/$defs/sha256"
        },
        "skill": {
          "$ref": "../defs.json#/$defs/skill"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "launch_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 200
        },
        "reused_retro": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/retro_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "running_retro": {
          "anyOf": [
            {
              "$ref": "../defs.json#/$defs/retro_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "daily_remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "dry_run",
        "scope",
        "matched",
        "matched_total",
        "skipped",
        "over_cap",
        "items",
        "items_by_kind",
        "digest_bytes",
        "key",
        "skill",
        "model",
        "launch_flags",
        "reused_retro",
        "running_retro",
        "daily_remaining"
      ],
      "additionalProperties": false,
      "description": "The dry-run plan. Never holds digest text."
    }
  ]
}
