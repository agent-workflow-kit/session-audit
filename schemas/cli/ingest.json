{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/cli/ingest.json",
  "title": "ingest output",
  "description": "Printed with --json on exit 0, including a partial run (complete false) and 'already running' (already_running true, all counts zero).",
  "type": "object",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "already_running": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "files": {
      "$ref": "../defs.json#/$defs/ingest_files"
    },
    "lines": {
      "$ref": "../defs.json#/$defs/ingest_lines"
    },
    "sessions": {
      "$ref": "../defs.json#/$defs/ingest_sessions"
    },
    "harness": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "captured": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "enabled",
        "matched",
        "captured",
        "errors"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "x-untrusted": true
      },
      "maxItems": 200
    }
  },
  "required": [
    "complete",
    "already_running",
    "dry_run",
    "files",
    "lines",
    "sessions",
    "harness",
    "warnings"
  ],
  "additionalProperties": false
}
