    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "internal",
            "usage",
            "config_invalid",
            "not_found",
            "vetoed",
            "failed",
            "needs_human",
            "session_ended",
            "refused",
            "ambiguous",
            "artifact_invalid"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "description": "A fixed string of the tool; never transcript, model or input text."
        },
        "details": {
          "type": "object",
          "properties": {
            "reason": {
              "enum": [
                "scope_too_large",
                "daily_limit",
                "config_unsafe",
                "live_sessions_only",
                "empty_scope",
                "store_newer",
                "already_exists",
                "in_use",
                "cron_block_malformed",
                "claude_session_missing",
                "claude_session_too_old",
                "sandbox_unavailable",
                "store_unwritable",
                "no_readable_roots",
                "session_not_started",
                "runner_lost",
                "no_artifact",
                "skill_not_found",
                "artifact_invalid",
                "identity_mismatch",
                "marker_mismatch",
                "no_valid_findings",
                "session_failed",
                "mode_unsupported",
                "confirmation_required"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "matched": {
              "type": "integer",
              "minimum": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            },
            "retro_id": {
              "$ref": "defs.json#/$defs/retro_id"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "matches": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "maxItems": 20,
              "uniqueItems": true
            },
            "field": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z_][a-z0-9_.-]{0,63}(?![\\s\\S])"
            },
            "hook": {
              "enum": [
                "pre-retro",
                "post-retro",
                "post-attention"
              ]
            },
            "outcome": {
              "$ref": "defs.json#/$defs/token"
            }
          },
          "required": [],
          "additionalProperties": false,
          "description": "Closed set of ids, counts and enums; never a path, a value or transcript or model text."
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false,
      "description": "Exit mapping: internal 1; usage and config_invalid 2; not_found 10; vetoed 11; failed 12; needs_human 13; session_ended 14-18 (details.outcome); refused 20; ambiguous 21; artifact_invalid 22. Exits 130 and 143 print no envelope.",
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "const": "refused"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "scope_too_large",
                      "daily_limit",
                      "config_unsafe",
                      "live_sessions_only",
                      "empty_scope",
                      "store_newer",
                      "already_exists",
                      "in_use",
                      "cron_block_malformed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "reason",
                  "retryable"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "claude_session_missing",
                      "claude_session_too_old",
                      "sandbox_unavailable",
                      "store_unwritable",
                      "no_readable_roots",
                      "session_not_started"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "artifact_invalid"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "enum": [
                      "runner_lost",
                      "no_artifact",
                      "skill_not_found",
                      "artifact_invalid",
                      "identity_mismatch",
                      "marker_mismatch",
                      "no_valid_findings",
                      "session_failed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "ambiguous"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "matches"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "not_found"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "details": {
                "required": [
                  "id"
                ]
              }
            }
          }
        }
      ]
    }
  }
