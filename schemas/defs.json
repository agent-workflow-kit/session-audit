      "required": [
        "id",
        "state",
        "reason",
        "key",
        "scope",
        "coverage",
        "skipped",
        "skill",
        "model",
        "created_at",
        "updated_at",
        "finished_at",
        "csession_id",
        "cost_usd",
        "num_turns",
        "outcome",
        "again_of",
        "counts",
        "metrics",
        "dropped",
        "summary",
        "findings",
        "candidates"
      ],
      "additionalProperties": false,
      "description": "The stored Retro object. Untrusted fields: summary, findings[].title and detail, candidates[].target_hint and proposal.",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "done"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "enum": [
                  "runner_lost",
                  "no_artifact",
                  "skill_not_found",
                  "artifact_invalid",
                  "identity_mismatch",
                  "marker_mismatch",
                  "no_valid_findings",
                  "session_failed"
                ]
              }
            }
          }
        }
      ]
