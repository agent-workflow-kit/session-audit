{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-audit/defs.json",
  "title": "session-audit shared definitions",
  "description": "Shared $defs referenced by the other schemas (config.json is self-contained). Fields marked x-untrusted carry transcript or model text.",
  "$defs": {
    "timestamp": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])",
      "description": "ISO 8601 with offset or Z."
    },
    "timestamp_ms": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z(?![\\s\\S])",
      "description": "UTC, YYYY-MM-DDTHH:MM:SS.mmmZ (log only)."
    },
    "date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])",
      "description": "YYYY-MM-DD in the configured time zone."
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "Lowercase hex SHA-256."
    },
    "sha256_16": {
      "type": "string",
      "minLength": 16,
      "maxLength": 16,
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "description": "First 16 hex characters of a SHA-256."
    },
    "session_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
      "description": "Claude Code session UUID, lowercase."
    },
    "csession_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])",
      "description": "A claude-session session id."
    },
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "retro_id": {
      "type": "string",
      "minLength": 11,
      "maxLength": 11,
      "pattern": "^ra-[a-z2-7]{8}(?![\\s\\S])",
      "description": "ra- followed by 8 lowercase base32 characters."
    },
    "actor": {
      "type": "string",
      "maxLength": 70,
      "pattern": "^(human|auto):[A-Za-z0-9._@/-]{1,64}(?![\\s\\S])",
      "description": "human:<user> or auto:<name>. Advisory."
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
      "description": "A short lowercase word owned by claude-session or this tool."
    },
    "label_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]{0,63}(?![\\s\\S])"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/@-]{1,128}(?![\\s\\S])"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-untrusted": true,
      "description": "A model name copied from a transcript."
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:_.-]{0,127}(?![\\s\\S])"
    },
    "ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5,
      "pattern": "^s[1-9][0-9]{0,3}(?![\\s\\S])",
      "description": "Session number inside one retro, s<N>."
    },
    "finding_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4,
      "pattern": "^f[1-9][0-9]{0,2}(?![\\s\\S])"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 3,
      "pattern": "^c[1-9][0-9]{0,1}(?![\\s\\S])"
    },
    "flag": {
      "enum": [
        "cost_mismatch",
        "no_usage",
        "no_timestamps",
        "truncated_tail",
        "old_rules"
      ]
    },
    "category": {
      "enum": [
        "went_well",
        "went_badly",
        "friction",
        "cost"
      ]
    },
    "target_class": {
      "enum": [
        "skill",
        "instructions_file",
        "config",
        "permission_profile",
        "workflow"
      ]
    },
    "retro_state": {
      "enum": [
        "digesting",
        "running",
        "validating",
        "done",
        "failed",
        "escalated",
        "canceled"
      ]
    },
    "retro_reason": {
      "enum": [
        "runner_lost",
        "no_artifact",
        "skill_not_found",
        "artifact_invalid",
        "identity_mismatch",
        "marker_mismatch",
        "no_valid_findings",
        "session_failed",
        "hook_escalated",
        "session_blocked",
        "session_needs_input",
        "interrupted"
      ]
    },
    "skipped": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "defs.json#/$defs/session_id"
        },
        "reason": {
          "const": "live"
        }
      },
      "required": [
        "session_id",
        "reason"
      ],
      "additionalProperties": false
    },
    "tokens4": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write"
      ],
      "additionalProperties": false,
      "description": "The four token counters."
    },
    "session_tokens": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "output": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read": {
          "type": "integer",
          "minimum": 0
        },
        "cache_write": {
          "type": "integer",
          "minimum": 0
        },
        "subagents": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "input",
        "output",
        "cache_read",
        "cache_write",
        "subagents"
      ],
      "additionalProperties": false,
      "description": "Session totals; subagents is the separate part counted from agent transcripts."
    },
    "cost": {
      "type": "object",
      "properties": {
        "reported_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "estimated_usd": {
          "type": "number",
          "minimum": 0
        },
        "unknown_tokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "reported_usd",
        "estimated_usd",
        "unknown_tokens"
      ],
      "additionalProperties": false,
      "description": "Cost bases are never added into one number."
    },
    "harness": {
      "type": "object",
      "properties": {
        "csession_id": {
          "$ref": "defs.json#/$defs/csession_id"
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}(?![\\s\\S])"
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "$ref": "defs.json#/$defs/label_key"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 256,
            "x-untrusted": true
          },
          "maxProperties": 64,
          "description": "Unauthenticated hints copied from claude-session."
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_reason": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "num_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "skill": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "const": "harness"
        }
      },
      "required": [
        "csession_id",
        "kind",
        "labels",
        "outcome",
        "end_reason",
        "cost_usd",
        "num_turns",
        "skill",
        "repo",
        "source"
      ],
      "additionalProperties": false,
      "description": "Snapshot copied once from claude-session; labels are unauthenticated."
    },
    "session": {
      "type": "object",
      "properties": {
        "session_id": {
          "$ref": "defs.json#/$defs/session_id"
        },
        "project": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "enum": [
            "interactive",
            "headless",
            "unknown"
          ]
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_seconds": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/model"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "tokens": {
          "$ref": "defs.json#/$defs/session_tokens"
        },
        "cost": {
          "$ref": "defs.json#/$defs/cost"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_errors": {
          "type": "integer",
          "minimum": 0
        },
        "denials": {
          "type": "integer",
          "minimum": 0
        },
        "interruptions": {
          "type": "integer",
          "minimum": 0
        },
        "subagents": {
          "type": "integer",
          "minimum": 0
        },
        "compactions": {
          "type": "integer",
          "minimum": 0
        },
        "parse_errors": {
          "type": "integer",
          "minimum": 0
        },
        "flags": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/flag"
          },
          "maxItems": 16,
          "uniqueItems": true
        },
        "harness": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/harness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "session_id",
        "project",
        "entrypoint",
        "version",
        "started_at",
        "ended_at",
        "active_seconds",
        "models",
        "tokens",
        "cost",
        "tool_calls",
        "tool_errors",
        "denials",
        "interruptions",
        "subagents",
        "compactions",
        "parse_errors",
        "flags",
        "harness"
      ],
      "additionalProperties": false,
      "description": "One stored session (counts and ids only, no conversation text)."
    },
    "agent": {
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "defs.json#/$defs/agent_id"
        },
        "parent_tool_call_id": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/agent_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "x-untrusted": true
            },
            {
              "type": "null"
            }
          ]
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/model"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "tokens": {
          "$ref": "defs.json#/$defs/tokens4"
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "tool_errors": {
          "type": "integer",
          "minimum": 0
        },
        "denials": {
          "type": "integer",
          "minimum": 0
        },
        "interruptions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "agent_id",
        "parent_tool_call_id",
        "agent_type",
        "models",
        "tokens",
        "tool_calls",
        "tool_errors",
        "denials",
        "interruptions"
      ],
      "additionalProperties": false,
      "description": "A subagent transcript linked to its parent session by the parent's tool-call id."
    },
    "usage_row": {
      "type": "object",
      "properties": {
        "day": {
          "$ref": "defs.json#/$defs/date"
        },
        "session_id": {
          "$ref": "defs.json#/$defs/session_id"
        },
        "agent_id": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/agent_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "$ref": "defs.json#/$defs/model"
        },
        "tokens": {
          "$ref": "defs.json#/$defs/tokens4"
        }
      },
      "required": [
        "day",
        "session_id",
        "agent_id",
        "model",
        "tokens"
      ],
      "additionalProperties": false,
      "description": "One row per (day, session, agent or main, model); agent_id null means the main transcript."
    },
    "scope": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 36,
            "pattern": "^[0-9a-f-]{8,36}(?![\\s\\S])"
          },
          "maxItems": 1000,
          "uniqueItems": true
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 400,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}=[^\\n\\r]{0,256}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "project": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "since": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "until": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/token"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sessions",
        "labels",
        "project",
        "since",
        "until",
        "kind",
        "outcome"
      ],
      "additionalProperties": false,
      "description": "Canonical retro scope (the flags of retro run, with since and until resolved to times)."
    },
    "coverage": {
      "type": "object",
      "properties": {
        "digest_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "items_total": {
          "type": "integer",
          "minimum": 0
        },
        "items_kept": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "defs.json#/$defs/ref"
              },
              "items_total": {
                "type": "integer",
                "minimum": 0
              },
              "items_kept": {
                "type": "integer",
                "minimum": 0
              },
              "dropped": {
                "type": "object",
                "properties": {
                  "session_cap": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_cap": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "required": [
                  "session_cap",
                  "total_cap"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "ref",
              "items_total",
              "items_kept",
              "dropped"
            ],
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "required": [
        "digest_bytes",
        "items_total",
        "items_kept",
        "sessions"
      ],
      "additionalProperties": false,
      "description": "Per session: items that existed, items kept and how many were dropped by which cap."
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "item",
            "metric"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false,
      "description": "Reference to a digest item id or a metric id of the manifest.",
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "item"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^s[1-9][0-9]{0,3}\\.i[0-9]{3,6}(?![\\s\\S])"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "metric"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "ref": {
                "pattern": "^(s[1-9][0-9]{0,3}|total)\\.(?!i[0-9]{3,6}(?![\\s\\S]))[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "defs.json#/$defs/finding_id"
        },
        "category": {
          "$ref": "defs.json#/$defs/category"
        },
        "severity": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "x-untrusted": true
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "x-untrusted": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/evidence"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "id",
        "category",
        "severity",
        "title",
        "detail",
        "evidence"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "defs.json#/$defs/candidate_id"
        },
        "target_class": {
          "$ref": "defs.json#/$defs/target_class"
        },
        "target_hint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "x-untrusted": true
        },
        "proposal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500,
          "x-untrusted": true
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/finding_id"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "target_class",
        "target_hint",
        "proposal",
        "findings"
      ],
      "additionalProperties": false
    },
    "retro_counts": {
      "type": "object",
      "properties": {
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
